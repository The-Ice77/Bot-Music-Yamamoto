# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set a guild ID for instant slash command registration during development
DEV_GUILD_ID=

# Lavalink v4.2+ Server
# Use "lavalink" inside Docker Compose or "localhost" when running locally
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=changeme-strong-password
LAVALINK_SECURE=false

# Spotify Web API (optional — required for Spotify links/playlists via LavaSrc)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Optional sp_dc cookie for algorithmic/private Spotify playlists
SPOTIFY_SP_DC=

# Persistence & Limits
DATABASE_PATH=./data/bot.sqlite
MAX_QUEUE_SIZE=500

# Logging (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
